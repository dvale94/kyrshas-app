{
  "name": "kyrshas-app",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": "22.23.4",
    "npm": "10.9.9"
  },
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 expo start --port 8082",
    "test": "EXPO_NO_DOTENV=1 jest --ci --runInBand --watchman=false",
    "check:expo": "EXPO_NO_DOTENV=1 EXPO_NO_TELEMETRY=1 expo install --check",
    "doctor": "EXPO_NO_DOTENV=1 EXPO_NO_TELEMETRY=1 expo-doctor",
    "export:ios": "EXPO_NO_DOTENV=1 EXPO_NO_TELEMETRY=1 expo export --platform ios --output-dir /private/tmp/kyrshas-legacy-root-export"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/native": "7.5.2",
    "@react-navigation/stack": "7.12.2",
    "expo": "~58.1.0",
    "expo-font": "~58.0.12",
    "expo-splash-screen": "~58.0.15",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "expo-doctor": "1.21.6",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.16",
    "test-renderer": "1.3.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo/ios",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/modernization/",
      "/showcase/"
    ]
  }
}
