{
  "name": "kyrshas-app-expo-next",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": "22.23.4",
    "npm": "10.9.9"
  },
  "scripts": {
    "start": "EXPO_NO_DOTENV=1 EXPO_NO_TELEMETRY=1 expo start",
    "test": "EXPO_NO_DOTENV=1 jest --ci --runInBand --watchman=false",
    "typecheck": "tsc --noEmit",
    "check:expo": "EXPO_NO_DOTENV=1 EXPO_NO_TELEMETRY=1 expo install --check",
    "check:config": "EXPO_NO_DOTENV=1 EXPO_NO_TELEMETRY=1 node scripts/check-config.cjs",
    "doctor": "EXPO_NO_DOTENV=1 EXPO_NO_TELEMETRY=1 expo-doctor",
    "verify": "npm run typecheck && npm test && npm run check:config && npm run check:expo && npm run doctor",
    "export:ios": "EXPO_NO_DOTENV=1 EXPO_NO_TELEMETRY=1 expo export --platform ios --output-dir dist"
  },
  "dependencies": {
    "expo": "58.0.25",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "expo-doctor": "1.21.6",
    "jest": "^30.0.0",
    "jest-expo": "58.0.14",
    "test-renderer": "1.3.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo/ios",
    "testMatch": ["<rootDir>/__tests__/**/*.test.tsx"]
  }
}
